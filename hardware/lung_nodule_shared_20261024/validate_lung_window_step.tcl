# Source in an OPEN design_1 BD. No synthesis, implementation, reset_runs or bit.
# Fail closed on disconnected/foreign clock/reset, or wrong addresses.
proc lung_require_equal {actual expected label} {
    if {$actual ne $expected} { error "${label}: expected '$expected', got '$actual'" }
}
proc lung_same_net {first second interface} {
    if {$interface} {
        set a [get_bd_intf_pins -quiet $first]
        set b [get_bd_intf_pins -quiet $second]
        if {[llength $a] != 1 || [llength $b] != 1} { error "Missing AXI endpoint: $first / $second" }
        set na [get_bd_intf_nets -quiet -of_objects $a]
        set nb [get_bd_intf_nets -quiet -of_objects $b]
    } else {
        set a [get_bd_pins -quiet $first]
        set b [get_bd_pins -quiet $second]
        if {[llength $a] != 1 || [llength $b] != 1} { error "Missing signal endpoint: $first / $second" }
        set na [get_bd_nets -quiet -of_objects $a]
        set nb [get_bd_nets -quiet -of_objects $b]
    }
    if {[llength $na] != 1 || $na ne $nb} { error "Disconnected/wrong net: $first / $second" }
}
proc lung_check_segment {space segment offset range} {
    set s [get_bd_addr_segs -quiet -of_objects [get_bd_addr_spaces $space]]
    set matches {}
    foreach item $s {
        if {[string match "*/$segment" $item]} { lappend matches $item }
    }
    if {[llength $matches] != 1} { error "Missing/ambiguous segment $space / $segment" }
    set o [get_property OFFSET $matches]
    set r [get_property RANGE $matches]
    # Vivado may display ranges as 1K or 512M, rather than hexadecimal bytes.
    foreach v {r} {
        if {[regexp -nocase {^([0-9]+)([KMG])$} [set $v] -> n unit]} {
            set shifts [dict create K 10 M 20 G 30]
            set $v [expr {$n << [dict get $shifts [string toupper $unit]]}]
        }
    }
    if {$o != $offset || $r != $range} { error "Wrong mapping $matches: offset=$o range=$r" }
}
if {[current_bd_design -quiet] eq ""} { error "Open design_1.bd before sourcing this checker" }
foreach {a b} {
    processing_system7_0/M_AXI_GP0 control_interconnect/S00_AXI
    control_interconnect/M00_AXI lung_conv8_axil_0/s_axi
    control_interconnect/M01_AXI lung_tensor_axil_0/s_axi
    lung_conv8_axil_0/m_axi memory_interconnect/S00_AXI
    lung_tensor_axil_0/m_axi memory_interconnect/S01_AXI
    memory_interconnect/M00_AXI processing_system7_0/S_AXI_HP0
} { lung_same_net $a $b 1 }
foreach pin {
    processing_system7_0/M_AXI_GP0_ACLK processing_system7_0/S_AXI_HP0_ACLK
    lung_conv8_axil_0/clk lung_tensor_axil_0/clk control_interconnect/aclk
    memory_interconnect/aclk proc_sys_reset_0/slowest_sync_clk
} { lung_same_net processing_system7_0/FCLK_CLK0 $pin 0 }
foreach pin {lung_conv8_axil_0/rst_n lung_tensor_axil_0/rst_n control_interconnect/aresetn memory_interconnect/aresetn} {
    lung_same_net proc_sys_reset_0/peripheral_aresetn $pin 0
}
lung_same_net processing_system7_0/FCLK_RESET0_N proc_sys_reset_0/ext_reset_in 0
lung_same_net const_one/dout proc_sys_reset_0/aux_reset_in 0
lung_same_net const_one/dout proc_sys_reset_0/dcm_locked 0
lung_same_net const_zero/dout proc_sys_reset_0/mb_debug_sys_rst 0
foreach key {C_EXT_RESET_HIGH C_AUX_RESET_HIGH} {
    lung_require_equal [get_property CONFIG.$key [get_bd_cells proc_sys_reset_0]] 0 "reset $key"
}
lung_require_equal [get_property CONFIG.CONST_VAL [get_bd_cells const_one]] 1 "inactive AUX reset constant"
lung_require_equal [get_property CONFIG.CONST_VAL [get_bd_cells const_zero]] 0 "debug reset constant"
set ps [get_bd_cells processing_system7_0]
foreach {key expected} {
    PCW_USE_M_AXI_GP0 1 PCW_USE_S_AXI_HP0 1 PCW_S_AXI_HP0_DATA_WIDTH 64
    PCW_EN_CLK0_PORT 1 PCW_EN_RST0_PORT 1
} { lung_require_equal [get_property CONFIG.$key $ps] $expected "PS $key" }
if {abs([get_property CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ $ps]-100.0)>0.001} { error "FCLK0 must be 100MHz" }
foreach {cell si mi} {control_interconnect 1 2 memory_interconnect 2 1} {
    lung_require_equal [get_property CONFIG.NUM_SI [get_bd_cells $cell]] $si "$cell NUM_SI"
    lung_require_equal [get_property CONFIG.NUM_MI [get_bd_cells $cell]] $mi "$cell NUM_MI"
}
# Segment names are deterministic Vivado assignments generated by the builder.
lung_check_segment processing_system7_0/Data SEG_lung_conv8_axil_0_Reg 0x43c00000 1024
lung_check_segment processing_system7_0/Data SEG_lung_tensor_axil_0_Reg 0x43c10000 1024
foreach engine {lung_conv8_axil_0 lung_tensor_axil_0} {
    lung_check_segment $engine/m_axi SEG_processing_system7_0_HP0_DDR_LOWOCM 0 0x20000000
}
validate_bd_design
save_bd_design
puts "Lung source-level BD checks PASS: GP0 controls, HP0 DDR, 100MHz shared clock and active-low shared reset."
puts "Not a timing/CDC/AXI sign-off: run elaboration and behavioral tests locally; no hardware run was launched."
